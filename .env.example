# =============================================================
#  Palmas TO / gta5modsfivem — variáveis de ambiente (EXEMPLO)
#  Copie para ".env" e preencha. NUNCA versione o arquivo .env.
# =============================================================

# URL pública do site (sem barra no final). Em produção:
# APP_URL="https://gta5modsfivem.com.br"
APP_URL="http://localhost:3000"

# Banco MySQL / MariaDB
DATABASE_URL="mysql://USUARIO:SENHA@127.0.0.1:3306/gta5modsfivem"

# Segredo usado para assinar links temporários de download e tokens.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_SECRET=""

# ---------- Armazenamento de arquivos ----------
# Diretórios locais. Os arquivos privados NUNCA devem ficar dentro de /public.
STORAGE_PUBLIC_DIR="./storage/public"
STORAGE_PRIVATE_DIR="./storage/private"
# Tamanho máximo de upload (MB) para arquivos de produto e para imagens
MAX_FILE_UPLOAD_MB=1024
MAX_IMAGE_UPLOAD_MB=8
# Validade (segundos) dos links temporários de download
DOWNLOAD_LINK_TTL_SECONDS=600

# ---------- InfinitePay (Checkout Integrado) ----------
# Sua InfiniteTag, SEM o "$". Obrigatória.
INFINITEPAY_HANDLE=""
# Chave da API (começa com "inchk_"). Opcional, mas necessária para
# links de uso único (single_payment) e com validade (valid_until).
# Crie no app/Conta Web InfinitePay. Fica SOMENTE no servidor.
INFINITEPAY_API_KEY=""
# Base da API (não altere em produção)
INFINITEPAY_API_BASE="https://api.checkout.infinitepay.io"
# Validade do link de pagamento (minutos), usada quando há API key
INFINITEPAY_LINK_TTL_MINUTES=60
# Habilita a criação de cobranças reais. Deixe "false" até validar.
INFINITEPAY_ENABLED="false"

# ---------- E-mail (recuperação de senha) ----------
# Se vazio, a recuperação de senha aparece como indisponível.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# ---------- Segurança ----------
# "true" quando o site estiver atrás de um proxy confiável (ex.: Nginx, Hostinger)
TRUST_PROXY="false"
